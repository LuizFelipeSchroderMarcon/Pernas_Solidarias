{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API para o Sistema Pernas Solidárias",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:init": "tsx src/database/setup.ts",
    "db:reset": "tsx src/database/reset.ts",
    "build": "tsc && node -e \"const fs = require('fs'); fs.mkdirSync('dist/database', { recursive: true }); fs.copyFileSync('src/database/init-database.sql', 'dist/database/init-database.sql');\"",
    "start": "node dist/server.js",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "supertest": "^7.3.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
