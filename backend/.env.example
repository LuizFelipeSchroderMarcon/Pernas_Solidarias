PORT=3000
# Conexão direta por parâmetros
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pernas_solidarias
DB_SSL=false

# Ou Conexão via URL (padrão de nuvem: AWS RDS, Neon, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/pernas_solidarias?sslmode=require

# Credenciais do administrador inicial (seed db:init)
INITIAL_ADMIN_EMAIL=admin@pernassolidarias.org.br
INITIAL_ADMIN_PASSWORD=admin123

# Segurança e CORS
JWT_SECRET=super_secret_jwt_key_pernas_solidarias_2026
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Opcional: fixar ID da instância para evitar perda de sessão a cada restart/hot-reload em dev
# SERVER_BOOT_ID=pernas_solidarias_boot_dev
