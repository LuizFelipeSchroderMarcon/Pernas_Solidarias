# ==============================================================================
# Variáveis de ambiente — Produção / Homologação (AWS EC2 + Cloudflare Tunnel)
# Copie para a raiz do projeto como .env e preencha com segredos reais:
#   cp deploy/env.producao.example .env && chmod 600 .env
# ==============================================================================

# Identificação do ambiente (prod para produção, hml para homologação)
AMBIENTE=prod

# Banco de dados PostgreSQL
DB_USER=postgres
DB_PASSWORD=GERE_COM_openssl_rand_-hex_24
DB_NAME=pernas_solidarias

# Autenticação JWT e CORS
JWT_SECRET=GERE_COM_openssl_rand_-hex_32
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://pernassolidarias.social.br

# Coordenador inicial (seed executado apenas se a tabela USER estiver vazia)
INITIAL_ADMIN_EMAIL=admin@pernassolidarias.org.br
INITIAL_ADMIN_PASSWORD=SENHA_FORTE_E_NOVA

# Frontend (proxy reverso no mesmo domínio via Nginx)
VITE_API_URL=/api

# Cloudflare Tunnel (token copiado em Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=SEU_TOKEN_DO_CLOUDFLARE_TUNNEL

# Observabilidade (Grafana em https://monitor.pernassolidarias.social.br)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SENHA_FORTE_DO_GRAFANA
GRAFANA_ROOT_URL=https://monitor.pernassolidarias.social.br

# Tag das imagens no GHCR:
# - Produção: latest (padrão) ou sha-<commit> para fixar/rollback
# - Homologação: dev ou dev-sha-<commit>
# TAG_IMAGEM=latest
