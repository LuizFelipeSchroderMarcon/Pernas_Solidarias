@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' ─── Configurações visuais ────────────────────────────────────────────────────
LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13

' ─── Título ───────────────────────────────────────────────────────────────────
title [Nível 1] Diagrama de Contexto — Sistema Pernas Solidárias

' ─── Ator principal ───────────────────────────────────────────────────────────
Person(coordenador, "Coordenador da ONG", "Responsável por cadastrar\nparticipantes e eventos,\nformar duplas e exportar\na relação para corridas.")

' ─── Sistema principal (caixa preta) ─────────────────────────────────────────
System(sistema, "Sistema Pernas Solidárias", "Aplicação web que centraliza\no gerenciamento de cadeirantes\ne condutores, automatiza a\nformação de duplas com base\nno histórico de participações\ne gera relatórios para envio\nàs organizações de corridas.")


' ─── Relacionamentos ─────────────────────────────────────────────────────────
Rel(coordenador, sistema, "Acessa via navegador web\npara gerenciar participantes,\neventos e duplas", "HTTPS")

@enduml